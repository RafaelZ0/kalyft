# Copie para .env.local (desenvolvimento, branch "dev" do Neon) e preencha.
# Nunca commite arquivos .env com valores reais. Guia completo: docs/BANCO.md

# Papel do APP (fuelift_app), com pooler (-pooler no host). Só SELECT/INSERT/UPDATE/DELETE.
DATABASE_URL=

# Papel DONO (neondb_owner), SEM pooler. Só para migrations, só na sua máquina.
# Não configurar no Vercel.
DATABASE_URL_MIGRACOES=

# Neon Auth: URL do console (Auth → Configuration) e segredo com 32+ caracteres.
# Gere o segredo com: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
NEON_AUTH_BASE_URL=
NEON_AUTH_COOKIE_SECRET=

# Chave do HMAC-SHA256 da tabela limites (32+ caracteres). Diferente por ambiente.
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
LIMITES_HMAC_KEY=

# E-mails dos administradores (aprovam novos cadastros), separados por vírgula.
ADMIN_EMAILS=

# IA do treino (Fase 3B). Chave criada em aistudio.google.com/apikey. Só no servidor, nunca no navegador.
GEMINI_API_KEY=
# Opcional: modelo do Gemini (padrão: gemini-3.5-flash).
GEMINI_MODEL=
# "gratuito" (padrão) ou "pago": no gratuito, o aviso de privacidade da tela de aceite fica mais forte.
IA_PLANO=gratuito
# "true" libera a IA só para o administrador (útil para testar antes de abrir a todos).
IA_SOMENTE_ADMIN=

# Lembretes (Fase 9F). Par VAPID diferente por ambiente. Gere com:
# node -e "const w=require('web-push');console.log(w.generateVAPIDKeys())"
# A chave PÚBLICA vai para o navegador (é ela que o aparelho usa para se inscrever); a PRIVADA nunca.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contato do remetente exigido pelo padrão Web Push: a URL do site (sem e-mail pessoal).
VAPID_SUBJECT=
# Segredo do agendador (GitHub Actions → /api/lembretes/enviar), 32+ caracteres. O mesmo valor fica no segredo
# CRON_SECRET do repositório no GitHub. Gere com:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
CRON_SECRET=
